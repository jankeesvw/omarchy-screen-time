#!/usr/bin/env python3
"""Screentime daemon."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from screentime import paths
from screentime.daemon import Daemon


def log(message):
    print(f"screentime: {message}", file=sys.stderr, flush=True)


def main():
    layout = paths.detect()
    log(f"starting in {layout.mode} mode")
    tick = float(os.environ.get("SCREENTIME_TICK_SECONDS", "5"))
    Daemon(layout, tick_seconds=tick, log=log).run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
