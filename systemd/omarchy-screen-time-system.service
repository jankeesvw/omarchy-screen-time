[Unit]
Description=Screen Time daemon (system wide)
Documentation=https://github.com/jankeesvw/omarchy-screen-time
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=@BINDIR@/omarchy-screen-timed
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
# Root, because the point of this mode is that the account being limited
# cannot stop it. It still needs /run/user/<uid> to notify the desktop, so
# the sandboxing stays modest on purpose.
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/omarchy-screen-time /run/omarchy-screen-time
RuntimeDirectory=omarchy-screen-time
RuntimeDirectoryMode=0755
StateDirectory=omarchy-screen-time
StateDirectoryMode=0700
# The state stays root's. The watched account reaches it only through the
# socket, which is group readable and nothing else: a child that can write
# these files can edit the very numbers this mode exists to enforce.
StateDirectoryQuota=64M
# The daemon binds a socket, reads /proc for peer credentials and talks to
# logind. It has no business anywhere else.
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
