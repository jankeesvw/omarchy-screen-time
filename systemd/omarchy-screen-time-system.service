[Unit]
Description=Screen Time daemon (system wide)
Documentation=https://github.com/jankeesvw/omarchy-screen-time
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=@BINDIR@/omarchy-screen-timed
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
# Root, because the point of this mode is that the account being limited
# cannot stop it. It still needs /run/user/<uid> to notify the desktop, so
# the sandboxing stays modest on purpose.
PrivateTmp=yes
ProtectSystem=strict
# /etc/omarchy-screen-time is in this list because the daemon writes its own
# config: the parent PIN, the profiles, the demo switch. ProtectSystem=strict
# makes all of /etc read-only, and without this line every one of those writes
# fails with EROFS while the daemon carries on with the change in memory, so a
# PIN appears to be set until the next restart takes it away again.
ReadWritePaths=/var/lib/omarchy-screen-time /run/omarchy-screen-time /etc/omarchy-screen-time
RuntimeDirectory=omarchy-screen-time
RuntimeDirectoryMode=0755
StateDirectory=omarchy-screen-time
StateDirectoryMode=0700
# The state stays root's. The watched account reaches it only through the
# socket, which is group readable and nothing else: a child that can write
# these files can edit the very numbers this mode exists to enforce.
#
# No StateDirectoryQuota here: it needs filesystem quota support, and on a
# plain btrfs root systemd cannot set it up and refuses to start the unit at
# all, with "Failed to set up special execution directory in /var/lib: No such
# device" and a restart loop behind it. A days-worth of JSON does not need a
# quota badly enough to make the service depend on how the disk was formatted.
# The daemon binds a socket, reads /proc for peer credentials and talks to
# logind. It has no business anywhere else.
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
